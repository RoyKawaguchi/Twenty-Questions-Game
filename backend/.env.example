# The environment mode. Options: development, production, testing
FLASK_ENV=development

# Your MongoDB connection string. 
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?options
MONGO_URI=your_mongodb_uri_here

# Your OpenAI API Key for AI features (starts with sk-...)
OPENAI_API_KEY=your_openai_api_key_here

# A secure, 64-character hex string used to sign JWT tokens.
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_generated_secret_key_here